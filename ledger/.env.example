# Copy is created automatically by `npm run setup`. Never commit the real .env!

# Local SQLite file (lives in prisma/dev.db)
DATABASE_URL="file:./dev.db"

# 32 random bytes, base64. Encrypts Plaid access tokens in the database.
# If you lose this key, connected banks must be re-linked.
ENCRYPTION_KEY=""

# Random string used to sign your login session cookie.
SESSION_SECRET=""

# From https://dashboard.plaid.com/developers/keys (Stage 2)
PLAID_CLIENT_ID=""
PLAID_SECRET=""
# sandbox | production   (Plaid's old "development" env was merged into production with limited free access)
PLAID_ENV="sandbox"
