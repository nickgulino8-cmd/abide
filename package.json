{
  "name": "abide",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ABIDE — a Catholic spiritual growth and habit recovery companion. Local-first, offline PWA.",
  "scripts": {
    "dev": "vite",
    "scripture": "tsx scripts/build-scripture.ts",
    "icons": "NODE_PATH=$(npm root -g) node scripts/build-icons.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "clsx": "^2.1.1",
    "framer-motion": "^14.13.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.72.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
